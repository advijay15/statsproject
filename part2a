% Load the cod sound template (replace with your actual file name)
[templateSignal, templateFs] = audioread('1407,3005_HawkinsT-1978_Gadus-morhua_Grunt-Aquarium.wav');

% Time axis
t = (0:length(templateSignal)-1) / templateFs;

% Plot time-series
figure;
subplot(2,1,1)
plot(t, templateSignal)
xlabel('Time (s)')
ylabel('Amplitude')
title('Time-Domain Plot of Cod Sound Template')
xlim([0 max(t)]); grid on;

% Spectrogram settings
window = 512;
noverlap = 256;
nfft = 2048;

% Compute spectrogram
[s, f, tt, p] = spectrogram(templateSignal, window, noverlap, nfft, templateFs, 'yaxis');

% Convert power to dB
p_db = 10*log10(abs(p));

% Plot spectrogram in dB
subplot(2,1,2)
surf(tt, f, p_db, 'EdgeColor', 'none');
axis tight;
view(0, 90);
ylim([0 1000]);  % Adjust if needed based on frequency content
xlabel('Time (s)');
ylabel('Frequency (Hz)');
title('Spectrogram of Cod Sound Template');
colorbar;
colormap(jet);  % optional: makes it colorful like the reference
