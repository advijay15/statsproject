function Part1c_Analysis
    % Part1c_Analysis.m
    %
    % This script loads each .mat file, extracts the time intervals
    % you provided for cod knocks vs. grunts, computes duration, peak freq,
    % bandwidth, etc. for each segment, then prints and averages them.
    %
    % Make sure your .mat files are in the current folder or specify
    % the correct folder path (e.g. 'Figures_MF_Analysis/Run2019-3-6-17-45-46.586.mat').

    fs = 8000;  % sampling frequency for your dataset

 % For knocks and grunts, each row is:
% { 'filename.mat', startTime_in_seconds, endTime_in_seconds }

% ===============================
% KNOCK EVENTS (No nested braces)
% ===============================
knockEvents = {
    'Run2019-3-6-17-45-46.586.mat', 9.30, 9.35;
    'Run2019-3-6-17-45-46.586.mat', 20.12, 20.14;

    'Run2019-3-6-17-42-46.576.mat', 16.77, 16.79;
    'Run2019-3-6-17-42-46.576.mat', 47.29, 47.31;

    'Run2019-3-6-17-16-46.533.mat', 42.75, 42.77;
    'Run2019-3-6-17-16-46.533.mat', 57.55, 57.57;

    'Run2019-3-6-17-14-46.523.mat', 18.17, 18.18;
    'Run2019-3-6-17-14-46.523.mat', 34.81, 34.83;

    'Run2019-3-6-17-11-46.533.mat', 11.90, 11.92;
    'Run2019-3-6-17-11-46.533.mat', 7.73,  7.75
};

% ===============================
% GRUNT EVENTS (No nested braces)
% ===============================
gruntEvents = {
    'Run2019-3-6-17-45-46.586.mat', 34.88, 35.00;
    'Run2019-3-6-17-45-46.586.mat', 29.20, 29.60;

    'Run2019-3-6-17-42-46.576.mat', 24.15, 24.25;
    'Run2019-3-6-17-42-46.576.mat', 55.60, 55.90;

    'Run2019-3-6-17-16-46.533.mat', 28.82, 28.90;
    'Run2019-3-6-17-16-46.533.mat', 39.32, 39.50;

    'Run2019-3-6-17-14-46.523.mat', 27.84, 28.10;
    'Run2019-3-6-17-14-46.523.mat', 39.62, 39.70;

    'Run2019-3-6-17-11-46.533.mat', 33.00, 33.20;
    'Run2019-3-6-17-11-46.533.mat', 25.43, 25.45
};




    % Analyze knocks vs. grunts
    knockStatsArray = processEvents(knockEvents, fs, 'KNOCK');
    gruntStatsArray = processEvents(gruntEvents, fs, 'GRUNT');

    %----------------------------------------------------------------------
    % 3) Compute Averages for Knocks vs. Grunts
    %----------------------------------------------------------------------
    if ~isempty(knockStatsArray)
        [avgDurK, avgPeakK, avgBWK] = computeAverages(knockStatsArray);
        fprintf('\n=== KNOCKS AVERAGE RESULTS ===\n');
        fprintf('Avg Duration (s):        %.4f\n',  avgDurK);
        fprintf('Avg Peak Frequency (Hz): %.2f\n',  avgPeakK);
        fprintf('Avg Bandwidth (Hz):      %.2f\n',  avgBWK);
    else
        fprintf('\n(No knock events provided.)\n');
    end

    if ~isempty(gruntStatsArray)
        [avgDurG, avgPeakG, avgBWG] = computeAverages(gruntStatsArray);
        fprintf('\n=== GRUNTS AVERAGE RESULTS ===\n');
        fprintf('Avg Duration (s):        %.4f\n',  avgDurG);
        fprintf('Avg Peak Frequency (Hz): %.2f\n',  avgPeakG);
        fprintf('Avg Bandwidth (Hz):      %.2f\n',  avgBWG);
    else
        fprintf('\n(No grunt events provided.)\n');
    end

    fprintf('\nDone.\n');
end

%=======================================================================
% Helper function: Loop through each event, load file, extract segment,
% compute parameters using "Compute_Fish_Params" below.
%=======================================================================
function statsArray = processEvents(events, fs, label)
    if isempty(events)
        statsArray = [];
        return;
    end
    statsArray = struct( ...
        'duration_sec',  {}, ...
        'peak_freq_hz',  {}, ...
        'lower_freq_hz', {}, ...
        'upper_freq_hz', {}, ...
        'bandwidth_hz',  {}, ...
        'filename',      {}, ...
        'start_time',    {}, ...
        'end_time',      {} ...
    );
    fprintf('\n--- Processing %s EVENTS ---\n', label);

    for i = 1:size(events,1)
        fileName = events{i,1};
        startT   = events{i,2};
        endT     = events{i,3};

        fprintf('\nEvent #%d: %s, Time=%.2f to %.2f s\n', i, fileName, startT, endT);

        % Load the .mat file
        dataStruct = load(fileName);
        signal = dataStruct.data(:,2);  % channel 2
        N = length(signal);

        % Convert start/end times to indices
        startIdx = max(1, round(startT*fs));
        endIdx   = min(N, round(endT*fs));

        % Extract the segment
        segment = signal(startIdx:endIdx);

        % Compute the parameters
        stats = Compute_Fish_Params(segment, fs);

        % Store the file name + time intervals
        stats.filename   = fileName;
        stats.start_time = startT;
        stats.end_time   = endT;

        % Append to the array
        statsArray(i) = stats; 
        disp(stats);
    end
end

%=======================================================================
% Helper function: Compute duration, peak frequency, bandwidth, etc.
%=======================================================================
function stats = Compute_Fish_Params(segment, fs)
    dt = 1/fs;
    N  = length(segment);

    % 1) Duration (threshold approach)
    threshold = 0.1 * max(abs(segment));
    idx = find(abs(segment) > threshold);

    if isempty(idx)
       duration_sec = 0;
    else
       duration_sec = (idx(end) - idx(1) + 1)*dt;
    end

    % 2) FFT to find peak freq
    w = hamming(N);
    seg_win = segment .* w;
    SEG = fft(seg_win);
    halfN = floor(N/2);
    SEG_mag = abs(SEG(1:halfN));
    freqs = (0:halfN-1)*(fs/N);

    [peak_val, peak_idx] = max(SEG_mag);
    peak_freq = freqs(peak_idx);

    % 3) Bandwidth via -3 dB
    amp_3dB = peak_val / sqrt(2);

    low_idx = peak_idx;
    while low_idx > 1 && SEG_mag(low_idx) > amp_3dB
        low_idx = low_idx - 1;
    end
    lower_freq = freqs(low_idx);

    high_idx = peak_idx;
    while high_idx < length(SEG_mag) && SEG_mag(high_idx) > amp_3dB
        high_idx = high_idx + 1;
    end
    upper_freq = freqs(high_idx);

    bandwidth = upper_freq - lower_freq;

    % Store results
    stats.duration_sec   = duration_sec;
    stats.peak_freq_hz   = peak_freq;
    stats.lower_freq_hz  = lower_freq;
    stats.upper_freq_hz  = upper_freq;
    stats.bandwidth_hz   = bandwidth;
end

%=======================================================================
% Helper function: Compute average of durations, peak freqs, bandwidths
%=======================================================================
function [avgDur, avgPeak, avgBW] = computeAverages(statsArray)
    durations = [statsArray.duration_sec];
    peaks     = [statsArray.peak_freq_hz];
    bws       = [statsArray.bandwidth_hz];

    avgDur  = mean(durations);
    avgPeak = mean(peaks);
    avgBW   = mean(bws);
end
