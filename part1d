function [avgFreq, avgSpectrum] = averageSpectrum(events, fs)
    Nfft = 1024;  % consistent FFT length for all signals
    allSpecs = zeros(length(events), Nfft/2);  % store magnitude-squared
    for i = 1:size(events,1)
        file = events{i,1};
        startT = events{i,2};
        endT = events{i,3};

        dataStruct = load(file);
        signal = dataStruct.data(:,2);
        startIdx = max(1, round(startT * fs));
        endIdx = min(length(signal), round(endT * fs));
        segment = signal(startIdx:endIdx);

        % Apply window and zero pad
        segment = segment(:) .* hamming(length(segment));
        segmentZP = zeros(Nfft,1);
        segmentZP(1:length(segment)) = segment;

        % FFT
        fftOut = fft(segmentZP);
        fftMag = abs(fftOut(1:Nfft/2)).^2;  % magnitude-squared
        allSpecs(i,:) = fftMag;
    end
    avgSpectrum = mean(allSpecs, 1);  % average intensity
    avgFreq = (0:Nfft/2-1)*(fs/Nfft);
end
